+int onz_valid_edge_name(char* bp){
+      if(bp[0] == '\0') return 0;
+      if(bp[0] == 'W' || bp[0] == 'w' || bp[0] == '+') return 1;
+      if(bp[0] == 'H' || bp[0] == 'h' || bp[0] == 'g') return 1;
+      if(bp[0] == 'S' || bp[0] == 's' || bp[0] == 'z') return 1;
+      return 0;
+}
